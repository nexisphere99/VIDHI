{
  "name": "vidhi-desktop",
  "productName": "VIDHI",
  "version": "0.4.0",
  "description": "VIDHI   The Body Swap Chronicles (desktop build). Thin Electron shell around dist/.",
  "private": true,
  "license": "UNLICENSED",
  "author": "vidhidevs",
  "homepage": "https://www.patreon.com/c/vidhidevs",
  "repository": "github:nexisphere99/VIDHI",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "version": "node scripts/version.js",
    "prune": "node scripts/prune-release.js",
    "pack": "node scripts/dist.js --dir",
    "dist": "node scripts/dist.js",
    "dist:mac": "node scripts/dist.js --mac",
    "dist:win": "node scripts/dist.js --win",
    "dist:linux": "node scripts/dist.js --linux",
    "dist:all": "node scripts/dist.js --mac --linux --win",
    "release": "(cd .. && ./build.sh) && npm run dist:all"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.vidhidevs.vidhi",
    "productName": "VIDHI",
    "copyright": "© vidhidevs",
    "directories": {
      "output": "release/${version}",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../dist",
        "to": "dist",
        "filter": ["**/*", "!**/.DS_Store"]
      }
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.games",
      "target": [
        { "target": "dmg", "arch": ["arm64", "x64"] }
      ],
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}"
    },
    "dmg": {
      "title": "${productName} ${version} ${arch}",
      "writeUpdateInfo": false
    },
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ],
      "artifactName": "${productName}-${version}-win-${arch}-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "differentialPackage": false
    },
    "linux": {
      "target": [
        { "target": "AppImage", "arch": ["x64", "arm64"] }
      ],
      "category": "Game",
      "artifactName": "${productName}-${version}-linux-${arch}.${ext}"
    }
  }
}
