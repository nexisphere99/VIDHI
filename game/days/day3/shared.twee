<<run setup.addItem("bike_keys", "arjun")>>\
<<run setup.removeItem("redmi_phone", "arjun")>>\
<<run setup.addItem("redmi_phone", "kavya")>>\
<<if $pov is "arjun">><<run setup.flag("arjun_day3_complete")>><<else>><<run setup.flag("kavya_day3_complete")>><</if>>\
